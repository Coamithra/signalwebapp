# Copy this file to `.env` (which is gitignored) and fill in your values.
# The server loads `.env` from the repo root automatically on startup, so you
# don't have to set these in your shell. Format is KEY=value, one per line —
# no spaces around `=`, no quotes needed.

# Giphy API key for the /gif picker. Get a free one at https://developers.giphy.com
# (sign in, Create an App, choose "API"). Without it, the picker just shows a
# "set your key" hint instead of GIFs.
GIPHY_API_KEY=

# Optional: max content rating for GIF results (g, pg, pg-13, r). Default: g
#GIPHY_RATING=g

# Auto-TLDR of YouTube links needs NO API key. Summaries are produced by
# spawning the Claude Code CLI (`claude`), so they bill your Claude subscription
# rather than a metered API key. Requirement: `claude` on the server's PATH and
# already logged in (`claude` once, interactively). With that in place you can
# enable "Auto-TLDR YouTube links" per chat (thread header -> options menu):
# links you post in an enabled chat get a short auto-summary. Without it, the
# toggle shows a hint.

# Optional: path to the CLI, if it isn't plain `claude` on PATH.
#TLDR_CLAUDE_BIN=claude

# Optional: which model writes the summary. Default: claude-opus-5
# (claude-sonnet-5 or claude-haiku-4-5 are cheaper against your usage limits).
#TLDR_MODEL=claude-opus-5

# Optional: set to 0 to drop the "For context" block (who the channel is, and
# how the video's claims hold up). That block is a SECOND Claude run per link,
# this one with web search, and the summary send WAITS on it: typically ~10-80s,
# capped at 5 minutes. Turning it off gets you the summary and quote alone, faster.
#TLDR_CONTEXT=1

# Optional: reasoning effort for the summary (low, medium, high, xhigh, max).
# Default: medium. `low` is a touch faster and still good; `high` and up buy
# very little on a summarization task.
#TLDR_EFFORT=medium

# Optional: the transcript is fetched directly (zero-dep). If YouTube bot-gates
# that and yt-dlp (https://github.com/yt-dlp/yt-dlp) is installed on PATH, it's
# used as a fallback. Set TLDR_YTDLP=0 to disable that fallback (never spawn it).
#TLDR_YTDLP=1
